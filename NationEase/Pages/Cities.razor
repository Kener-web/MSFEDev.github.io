@page "/cities"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@inject LocalNationService Nation
@inject LocalAuthenticationService Authentication
@inject IJSRuntime JS

<PageTitle>Cities - NationBuilder</PageTitle>

<h1>Cities</h1>

<EditForm Model="cityForm" OnValidSubmit="SaveCity" class="row g-2 mb-4 city-edit-form">
    <DataAnnotationsValidator />
    <div class="col-md-2">
        <label for="city-state" class="form-label">State</label>
        <InputSelect id="city-state" class="form-select" @bind-Value="cityForm.StateId">
            <option value="0" disabled>Select State</option>
            @foreach (var state in states.OrderBy(state => state.Acronym, StringComparer.OrdinalIgnoreCase))
            {
                <option value="@state.StateId">[@state.Acronym] @state.Name</option>
            }
        </InputSelect>
    </div>
    <div class="col-md-2">
        <label for="city-name" class="form-label">City</label>
        <InputText id="city-name" class="form-control" @bind-Value="cityForm.Name" @oninput="CheckInput" />
    </div>
    <div class="col-md-2">
        <label for="city-founded" class="form-label">Founding date</label>
        <InputDate id="city-founded" class="form-control" @bind-Value="cityForm.FoundingDate" />
    </div>
    <div class="col-md-2">
        <label for="city-population" class="form-label">Population</label>
        <InputNumber id="city-population" class="form-control" @bind-Value="cityForm.Population" />
    </div>
    <div class="col-md-1">
        <label for="city-latitude" class="form-label">Latitude</label>
        <InputNumber id="city-latitude" class="form-control" @bind-Value="cityForm.Latitude" />
    </div>
    <div class="col-md-1">
        <label for="city-longitude" class="form-label">Longitude</label>
        <InputNumber id="city-longitude" class="form-control" @bind-Value="cityForm.Longitude" />
    </div>
    <div class="col-md-2 d-flex flex-wrap align-items-end justify-content-md-end gap-2">
        <button type="submit" class="btn btn-primary">@(editingCityId is null ? "Add City" : "Save changes")</button>
        @if (editingCityId is not null)
        {
            <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
        }
    </div>
    <ValidationSummary />
</EditForm>

<SecurityWarningPopup Message="@inputSecurityWarning" OnDismiss="DismissInputWarning" />

@if (!string.IsNullOrWhiteSpace(operationError))
{
    <div class="alert alert-danger" role="alert">@operationError</div>
}

<div class="table-responsive cities-compact-list" role="region" aria-label="Cities list" tabindex="0">
    <table class="table">
    <colgroup>
        <col class="city-actions-column" />
        <col class="city-name-column" />
        <col class="city-founded-column" />
        <col class="city-population-column" />
        <col class="city-coordinate-column" />
        <col class="city-coordinate-column" />
    </colgroup>
    <thead>
        <tr>
            <th scope="col">Actions</th>
            <th scope="col">City</th>
            <th scope="col">Founded</th>
            <th scope="col" class="text-end">Population</th>
            <th scope="col" class="text-end">Latitude</th>
            <th scope="col" class="text-end">Longitude</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var city in cities.OrderByDescending(city => city.Population))
        {
            var isAdded = selectedCityIds.Contains(city.CityId);

            <tr data-city-id="@city.CityId">
                <td class="city-list-actions">
                    <button type="button"
                            class="btn btn-sm btn-outline-primary"
                            aria-label="Edit @city.Name"
                            @onclick="() => EditCity(city)">Edit</button>
                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            aria-label="Delete @city.Name"
                            @onclick="() => DeleteCity(city.CityId)">Delete</button>
                    <button type="button"
                            class="btn btn-sm btn-primary"
                            disabled="@isAdded"
                            aria-label="@(isAdded ? $"Added {city.Name} to Nation" : $"Add {city.Name} to Nation")"
                            @onclick="() => AddCity(city)">
                        @(isAdded ? "Added" : "Add")
                    </button>
                </td>
                <td class="city-list-name">[@city.StateAcronym] @city.Name</td>
                <td>@(city.FoundingDate?.ToString("yyyy/MM/dd", CultureInfo.InvariantCulture) ?? "Unknown")</td>
                <td class="text-end">@city.Population.ToString("N0", CultureInfo.InvariantCulture)</td>
                <td class="text-end">@FormatCoordinate(city.Latitude)</td>
                <td class="text-end">@FormatCoordinate(city.Longitude)</td>
            </tr>
        }
    </tbody>
    </table>
</div>

@code
{
    private List<StateResponse> states = new();
    private List<CityResponse> cities = new();
    private HashSet<int> selectedCityIds = new();
    private CityFormModel cityForm = new();
    private int? editingCityId;
    private int? cityIdToFocus;
    private string? operationError;
    private string? inputSecurityWarning;
    private bool inputSecurityWarningDismissed;

    private static string FormatCoordinate(decimal? coordinate) =>
        coordinate?.ToString("F6", CultureInfo.InvariantCulture) ?? "—";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var userId = Authentication.CurrentUser!.UserId;
        states = await Nation.GetStatesAsync(userId);
        cities = await Nation.GetCitiesAsync(userId);
        selectedCityIds = (await Nation.GetCartAsync(userId)).Select(city => city.CityId).ToHashSet();
    }

    private async Task SaveCity()
    {
        if (!ValidateInputSafety())
        {
            return;
        }

        operationError = null;
        try
        {
            if (editingCityId is int id)
            {
                await Nation.UpdateCityAsync(Authentication.CurrentUser!.UserId, id, new UpdateCityRequest
                {
                    StateId = cityForm.StateId,
                    Name = cityForm.Name,
                    Population = cityForm.Population,
                    FoundingDate = cityForm.FoundingDate,
                    Latitude = cityForm.Latitude,
                    Longitude = cityForm.Longitude
                });
            }
            else
            {
                await Nation.CreateCityAsync(Authentication.CurrentUser!.UserId, new CreateCityRequest
                {
                    StateId = cityForm.StateId,
                    Name = cityForm.Name,
                    Population = cityForm.Population,
                    FoundingDate = cityForm.FoundingDate,
                    Latitude = cityForm.Latitude,
                    Longitude = cityForm.Longitude
                });
            }

            CancelEdit();
            await LoadData();
        }
        catch (InvalidOperationException exception)
        {
            operationError = exception.Message;
        }
        catch (JSException exception)
        {
            operationError = $"The city could not be saved: {exception.Message}";
        }
    }

    private async Task AddCity(CityResponse city)
    {
        if (selectedCityIds.Contains(city.CityId))
        {
            return;
        }

        operationError = null;
        try
        {
            await Nation.AddToCartAsync(Authentication.CurrentUser!.UserId, city.CityId);
            selectedCityIds.Add(city.CityId);
            cityIdToFocus = city.CityId;
        }
        catch (KeyNotFoundException exception)
        {
            operationError = exception.Message;
        }
        catch (JSException exception)
        {
            operationError = $"The city could not be added to your cart: {exception.Message}";
        }
    }

    private void EditCity(CityResponse city)
    {
        editingCityId = city.CityId;
        cityForm = new CityFormModel
        {
            StateId = city.StateId,
            Name = city.Name,
            Population = city.Population,
            FoundingDate = city.FoundingDate,
            Latitude = city.Latitude,
            Longitude = city.Longitude
        };
        operationError = null;
    }

    private async Task DeleteCity(int cityId)
    {
        operationError = null;
        try
        {
            await Nation.DeleteCityAsync(Authentication.CurrentUser!.UserId, cityId);
            await LoadData();
        }
        catch (KeyNotFoundException exception)
        {
            operationError = exception.Message;
        }
        catch (JSException exception)
        {
            operationError = $"The city could not be deleted: {exception.Message}";
        }
    }

    private void CancelEdit()
    {
        editingCityId = null;
        cityForm = new CityFormModel();
    }

    private void CheckInput(ChangeEventArgs args)
    {
        var warning = InputSecurityGuard.GetWarning(args.Value?.ToString());
        if (warning is null)
        {
            inputSecurityWarning = null;
            inputSecurityWarningDismissed = false;
        }
        else if (!inputSecurityWarningDismissed)
        {
            inputSecurityWarning = warning;
        }
    }

    private bool ValidateInputSafety()
    {
        inputSecurityWarning = InputSecurityGuard.GetWarning(cityForm.Name);
        inputSecurityWarningDismissed = false;
        return inputSecurityWarning is null;
    }

    private void DismissInputWarning()
    {
        inputSecurityWarning = null;
        inputSecurityWarningDismissed = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (cityIdToFocus is not int cityId)
        {
            return;
        }

        cityIdToFocus = null;
        await JS.InvokeVoidAsync("nationEaseKeyboard.focusCityAction", cityId);
    }

    private sealed class CityFormModel
    {
        [Required, StringLength(150)]
        public string Name { get; set; } = string.Empty;

        [Range(1, int.MaxValue, ErrorMessage = "Select a state.")]
        public int StateId { get; set; }

        [Range(0, long.MaxValue)]
        public decimal Population { get; set; }

        public DateOnly? FoundingDate { get; set; } = DateOnly.FromDateTime(DateTime.Now);

        [Range(typeof(decimal), "-90", "90")]
        public decimal? Latitude { get; set; }

        [Range(typeof(decimal), "-180", "180")]
        public decimal? Longitude { get; set; }
    }
}
