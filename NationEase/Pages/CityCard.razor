@using NationEase.Models
@inject IJSRuntime JS

<table class="table">
    <thead>
        <tr>
            <th></th>
            <th>City</th>
            <th>Population</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var city in Cities)
        {
            var isAdded = SelectedCityIds.Contains(city.CityId);

            <tr data-city-id="@city.CityId">
                <td>
                    <button type="button"
                            class="btn btn-primary"
                            aria-disabled="@isAdded"
                            aria-label="@(isAdded ? $"Added {city.Name} to Nation" : $"Add {city.Name} to Nation")"
                            @onclick="() => AddCity(city, isAdded)">
                        @(isAdded ? "Added" : "Add to Nation")
                    </button>
                </td>
                <td>[@city.State?.Acronym] @city.Name</td>
                <td>@city.Population.ToString("N0")</td>
            </tr>
        }
    </tbody>
</table>

@code
{
    [Parameter, EditorRequired]
    public IReadOnlyList<City> Cities { get; set; } = Array.Empty<City>();

    [Parameter]
    public IReadOnlySet<int> SelectedCityIds { get; set; } = new HashSet<int>();

    [Parameter, EditorRequired]
    public EventCallback<City> OnAddCity { get; set; }

    private int? cityIdToFocus;

    private async Task AddCity(City city, bool isAdded)
    {
        if (isAdded)
        {
            return;
        }

        await OnAddCity.InvokeAsync(city);
        cityIdToFocus = city.CityId;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (cityIdToFocus is not int cityId)
        {
            return;
        }

        cityIdToFocus = null;
        await JS.InvokeVoidAsync("nationEaseKeyboard.focusCityAction", cityId);
    }
}