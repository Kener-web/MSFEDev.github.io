@page "/nation-builder"
@using System.Globalization

@inject LocalNationService Nation
@inject LocalAuthenticationService Authentication
@inject IJSRuntime JS

<PageTitle>Nation Builder - NationBuilder</PageTitle>

<h1>Nation Builder</h1>

@if (!string.IsNullOrWhiteSpace(operationError))
{
    <div class="alert alert-danger" role="alert">@operationError</div>
}

<button type="button"
        class="btn btn-warning nation-clear-button"
        @onclick="ClearNation">
    Clear Nation
</button>

<div class="table-responsive nation-city-list" role="region" aria-label="Selected cities" tabindex="0">
    <table class="table">
        <colgroup>
            <col class="nation-city-actions-column" />
            <col />
            <col class="nation-city-population-column" />
        </colgroup>
        <thead>
            <tr>
                <th scope="col">Actions</th>
                <th scope="col">City</th>
                <th scope="col" class="text-center">Population</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var city in cities
                .OrderBy(city => city.StateAcronym, StringComparer.OrdinalIgnoreCase)
                .ThenBy(city => city.Name, StringComparer.OrdinalIgnoreCase))
            {
                <tr data-city-id="@city.CityId">
                    <td>
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                aria-label="Remove @city.Name from Nation"
                                @onclick="() => RemoveCity(city.CityId)">
                            Remove
                        </button>
                    </td>
                    <td>[@city.StateAcronym] @city.Name</td>
                    <td class="text-center">@city.Population.ToString("N0", CultureInfo.InvariantCulture)</td>
                </tr>
            }
            @if (cities.Count == 0)
            {
                <tr>
                    <td colspan="3">No cities have been added to your nation yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@code {
    private List<CityResponse> cities = new();
    private int? cityIdToFocus;
    private bool focusAfterRemove;
    private string? operationError;

    protected override async Task OnInitializedAsync()
    {
        await LoadCart();
    }

    private async Task LoadCart()
    {
        cities = await Nation.GetCartAsync(Authentication.CurrentUser!.UserId);
    }

    private async Task RemoveCity(int cityId)
    {
        operationError = null;
        try
        {
            var orderedCities = cities
                .OrderBy(city => city.StateAcronym, StringComparer.OrdinalIgnoreCase)
                .ThenBy(city => city.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            var removedCityIndex = orderedCities.FindIndex(city => city.CityId == cityId);
            cityIdToFocus = removedCityIndex > 0
                ? orderedCities[removedCityIndex - 1].CityId
                : removedCityIndex >= 0 && removedCityIndex + 1 < orderedCities.Count
                    ? orderedCities[removedCityIndex + 1].CityId
                    : null;

            await Nation.RemoveFromCartAsync(Authentication.CurrentUser!.UserId, cityId);
            await LoadCart();
            focusAfterRemove = true;
        }
        catch (JSException exception)
        {
            operationError = $"The city could not be removed from your cart: {exception.Message}";
        }
    }

    private async Task ClearNation()
    {
        operationError = null;
        try
        {
            await Nation.ClearCartAsync(Authentication.CurrentUser!.UserId);
            await LoadCart();
        }
        catch (JSException exception)
        {
            operationError = $"Your cart could not be cleared: {exception.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusAfterRemove)
        {
            return;
        }

        focusAfterRemove = false;
        if (cityIdToFocus is int cityId)
        {
            await JS.InvokeVoidAsync("nationEaseKeyboard.focusNationBuilderAction", cityId);
        }
        else
        {
            await JS.InvokeVoidAsync("nationEaseKeyboard.focusClearNationButton");
        }

        cityIdToFocus = null;
    }
}