@page "/nation-builder"

@using NationEase.Services

@inject NationBuilderService Builder
@inject IJSRuntime JS

<h3>Nation Builder</h3>

<p>
    Cities Selected:
    @Builder.NationBuilder.Cities.Count
</p>
<p>
    Total Population:
    @Builder.NationBuilder.TotalPopulation.ToString("N0")
</p>
<p>
    Average Population:
    @Builder.NationBuilder.AveragePopulation.ToString("N0")
</p>
<p>
    Largest City:
    @Builder.NationBuilder.LargestCity?.Name
</p>
<p>
    Smallest City:
    @Builder.NationBuilder.SmallestCity?.Name
</p>



<table class="table">

    <thead>

        <tr>
            <th></th>
            <th>City</th>
            <th>Population</th>
        </tr>

    </thead>

    <tbody>

        @foreach(var city in Builder.NationBuilder.Cities.OrderByDescending(c => c.Population))
        {
            <tr data-city-id="@city.CityId">
                <td>
                    <button type="button"
                            class="btn btn-danger"
                            @onclick="() => RemoveCity(city.CityId)">
                        Remove
                    </button>
                </td>
                <td>
                    [@city.State?.Acronym]
                    @city.Name
                </td>

                <td>@city.Population.ToString("N0")</td>
            </tr>
        }

    </tbody>

</table>
<button type="button"
        class="btn btn-warning"
        @onclick="ClearNation">
    Clear Nation
</button>


@code {
    private int? cityIdToFocus;
    private bool focusAfterRemove;

    private void RemoveCity(int cityId)
    {
        var cities = Builder.NationBuilder.Cities
            .OrderByDescending(city => city.Population)
            .ToList();
        var removedCityIndex = cities.FindIndex(city => city.CityId == cityId);
        cityIdToFocus = removedCityIndex > 0
            ? cities[removedCityIndex - 1].CityId
            : removedCityIndex >= 0 && removedCityIndex + 1 < cities.Count
                ? cities[removedCityIndex + 1].CityId
                : null;

        Builder.NationBuilder.RemoveCity(cityId);
        focusAfterRemove = true;
    }

    private void ClearNation()
    {
        Builder.NationBuilder.Clear();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusAfterRemove)
        {
            return;
        }

        focusAfterRemove = false;
        if (cityIdToFocus is int cityId)
        {
            await JS.InvokeVoidAsync("nationEaseKeyboard.focusNationBuilderAction", cityId);
        }
        else
        {
            await JS.InvokeVoidAsync("nationEaseKeyboard.focusClearNationButton");
        }

        cityIdToFocus = null;
    }
}